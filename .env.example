# AI provider (OpenAI-compatible endpoint)
# Examples:
# OpenAI:        https://api.openai.com/v1
# Local Ollama:  http://localhost:11434/v1
# Gemini:        https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-4o-mini

# Optional: separate speech-to-text provider. Defaults to AI_BASE_URL/AI_API_KEY if omitted.
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_API_KEY=your_api_key_here
WHISPER_MODEL=whisper-1

# Local Whisper server (server/whisper_server.py) model size.
# Options: tiny, base, small, medium, large-v3
# small = better accuracy than base (~460MB one-time download)
WHISPER_LOCAL_MODEL=small

# Server
PORT=5000
NODE_ENV=development

# Client (build-time)
VITE_API_BASE_URL=http://localhost:5000/api
